APP_NAME=Finance Tracker API
DEBUG=true
ENVIRONMENT=development

# --- PostgreSQL (один источник для Alembic на хосте и для docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finance_tracker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Пароль здесь должен совпадать с уже созданным кластером в Docker-томе postgres_data
# (или задайте свой и пересоздайте том: docker compose down -v).
#
# Строки DATABASE_URL ниже НЕ обязательны: если их нет, приложение соберёт URL из POSTGRES_* выше
# (удобно не дублировать пароль и не ловить asyncpg InvalidPasswordError).
#
# Раскомментируйте только для нестандартного URL (или если явно нужен другой хост, не из POSTGRES_*):

# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/finance_tracker
# DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/finance_tracker

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
RATE_LIMIT_AUTH=10/minute

GOAL_DEADLINE_WARNING_DAYS=7
BUDGET_WARNING_THRESHOLD=0.8
